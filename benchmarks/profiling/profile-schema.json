{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized Go pprof run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "started_at", "git_commit", "working_tree_clean",
    "stack", "profiler", "environment", "configuration", "load_result",
    "application_metrics", "service_resources", "profile_summary", "graceful_shutdown"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "git_commit": { "type": ["string", "null"] },
    "working_tree_clean": { "type": "boolean" },
    "stack": { "const": "go" },
    "profiler": { "const": "go tool pprof" },
    "environment": { "type": "object" },
    "configuration": { "type": "object" },
    "load_result": { "type": "object" },
    "application_metrics": { "type": "object" },
    "service_resources": { "type": "object" },
    "profile_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_type", "sample_duration_seconds", "total_cpu_samples_seconds", "top_functions", "raw_profile_retained"],
      "properties": {
        "profile_type": { "const": "cpu" },
        "sample_duration_seconds": { "type": "integer", "minimum": 1 },
        "total_cpu_samples_seconds": { "type": "number", "minimum": 0 },
        "raw_profile_retained": { "const": false },
        "top_functions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "flat_seconds", "flat_percent", "cumulative_seconds", "cumulative_percent"],
            "properties": {
              "symbol": { "type": "string", "maxLength": 120 },
              "flat_seconds": { "type": "number", "minimum": 0 },
              "flat_percent": { "type": "number", "minimum": 0 },
              "cumulative_seconds": { "type": "number", "minimum": 0 },
              "cumulative_percent": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "graceful_shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "exit_code", "timed_out"],
      "properties": {
        "duration_seconds": { "type": "number", "minimum": 0 },
        "exit_code": { "type": "integer" },
        "timed_out": { "type": "boolean" }
      }
    }
  }
}
